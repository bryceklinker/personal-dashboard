@using Personal.Dashboard.Models

@inject HttpClient Client

<MudGrid>
    <MudItem xs="12">

    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-1">
            <MudList Class="d-flex flex-1" T="FootballLeagueModel">
                @foreach (var league in Leagues.Items)
                {
                    <MudListItem>
                        <MudText Typo="Typo.body1">@league.Name</MudText>
                    </MudListItem>
                }
            </MudList>
            <MudStack>
                <MudIconButton Icon="@Icons.Material.Rounded.NavigateNext"
                               OnClick="@GoToNext"
                               Disabled="@(!HasNextPage)"
                               UserAttributes="@(
                                               new Dictionary<string, object?>
                                               {
                                                   { "aria-label", "next" },
                                                   { "role", "button" }
                                               }
                                               )"
                />
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>



@code {
    private PagedListResultModel<FootballLeagueModel> Leagues { get; set; } = PagedListResultModel<FootballLeagueModel>.Empty();

    private bool HasNextPage => Leagues.Total > Leagues.Limit;

    protected override async Task OnInitializedAsync()
    {
        Leagues = await Client.GetFromJsonAsync<PagedListResultModel<FootballLeagueModel>>("/leagues")
                  ?? PagedListResultModel<FootballLeagueModel>.Empty();
    }

    private async Task GoToNext()
    {
        Leagues = await Client.GetFromJsonAsync<PagedListResultModel<FootballLeagueModel>>("/leagues?offset=10")
                  ?? PagedListResultModel<FootballLeagueModel>.Empty();
        StateHasChanged();
    }

}