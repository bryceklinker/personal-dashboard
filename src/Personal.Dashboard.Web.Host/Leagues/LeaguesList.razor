@using Personal.Dashboard.Models
@using Personal.Dashboard.Web.Host.Common.Apis

@inject PersonalDashboardApiClient Client

<MudGrid>
    <MudItem xs="12">

    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-1">
            <MudList Class="d-flex flex-1" T="FootballLeagueModel">
                @foreach (var league in Leagues.Items)
                {
                    <MudListItem>
                        <MudText Typo="Typo.body1">@league.Name</MudText>
                    </MudListItem>
                }
            </MudList>
            <MudStack>
                <MudIconButton Icon="@Icons.Material.Rounded.NavigateBefore"
                               OnClick="@GoToPrevious"
                               role="button"
                               aria-label="previous"
                />
                <MudIconButton Icon="@Icons.Material.Rounded.NavigateNext"
                            OnClick="@GoToNext"
                            Disabled="@(!HasNextPage)"
                            role="button"
                            aria-label="next"/>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>



@code {
    private PagedListResultModel<FootballLeagueModel> Leagues { get; set; } = PagedListResultModel<FootballLeagueModel>.Empty();

    private bool HasNextPage => Leagues.Total > Leagues.Limit;

    protected override async Task OnInitializedAsync()
    {
        Leagues = await Client.GetLeaguesAsync();
    }

    private async Task GoToNext()
    {
        Leagues = await Client.GetLeaguesAsync(new PagedListParameters(offset: 10));
        StateHasChanged();
    }

    private async Task GoToPrevious()
    {
        Leagues = await Client.GetLeaguesAsync(new PagedListParameters(offset: 0));
        StateHasChanged();
    }

}