@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MainAppBar OnMenuClick="ToggleMenu"/>
    <NavigationMenu IsNavigationOpen="_isNavigationOpen"/>
    <MudMainContent>
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isNavigationOpen;

    private void ToggleMenu()
    {
        _isNavigationOpen = !_isNavigationOpen;
    }
}