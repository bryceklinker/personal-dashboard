@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout Class="d-flex flex-1">
    <MainAppBar OnMenuClick="ToggleMenu"/>
    <NavigationMenu IsNavigationOpen="_isNavigationOpen"/>
    <MudMainContent Class="d-flex flex-1">
        <MudContainer Class="d-flex flex-1 mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isNavigationOpen;

    private void ToggleMenu()
    {
        _isNavigationOpen = !_isNavigationOpen;
    }
}